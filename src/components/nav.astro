---

const navItems = [
  {
    name: 'About Me',
    href: '#aboutMe',
  },
  {
    name: 'Experience',
    href: '#experience',
  },
  {
    name: 'My Projects',
    href: '#projects',
  },
  {
    name: 'Contact Me',
    href: `mailto:mlunav99@gmail.com`,
  },
]


---

<!-- <section class="hidden md:flex flex-col items-center w-full bg-[var(--navbar-background)] sticky top-0 z-50 shadow-sm text-gray-400"> -->
  <header class="flex flex-col items-center px-6 py-6 w-full md:px-16 md:py-6">
    <nav class="flex justify-between items-center xl:w-[1312px]">
      <div class="flex flex-col">
        <a href="/">
          <img
            class="w-8 h-8"
            src="/favicon.svg"
            alt="logo"
            width={32}
            height={32}
          />
        </a>
      </div>
      <div class="md:flex md:items-center hidden">
        <ul class="navbar flex justify-between items-center list-none m-1 text-sm">
          {
            navItems.map((item) => (
              <li class="mx-3">
                <a
                  href={item.href}
                  class="text-gray-400 hover:text-[var(--primary)] transition-all duration-300"
                >
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <a class="border-[var(--primary)] border-1 rounded-md px-3 py-2 text-[var(--primary)] hover:bg-[var(--primary-10)] transition-all duration-300 text-xs" href="resume.pdf" target="_blank">
        Resume
      </a>
    </nav>
  </header>
<!-- </section> -->
